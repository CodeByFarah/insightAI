# Copy to .env and fill in. Never commit .env.

# --- Database (required) ---
DATABASE_URL=postgresql+psycopg://insightai:insightai@localhost:5432/insightai

# --- AI assistant (optional) ---
# Leave GEMINI_API_KEY empty to run without AI. Everything except the assistant
# keeps working, and the UI says the assistant is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# --- Application ---
ENVIRONMENT=development
DEBUG=false
MAX_UPLOAD_BYTES=20971520
PREVIEW_ROWS=20
CORS_ORIGINS=http://localhost:5173
DEFAULT_USER_EMAIL=demo@insightai.local
STORAGE_DIR=backend/storage
